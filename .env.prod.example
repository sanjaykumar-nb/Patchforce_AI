# ==============================================================================
# PatchForge AI - Production Environment Template (docker-compose.prod.yml)
# ==============================================================================
# Copy this file to `.env.prod` and fill in every value below.
# `docker compose --env-file .env.prod -f docker-compose.prod.yml up -d` will
# refuse to start if any required value is missing.

# --- Public domain ---
# The domain/subdomain this deployment is served on. Caddy automatically
# provisions a Let's Encrypt TLS certificate for it, and the backend uses it
# to build CORS_ORIGINS. Its DNS A record must point at this server's public
# IP before starting the stack, or Caddy's certificate request will fail.
DOMAIN=patchforge.example.com

# --- Secrets: generate each with `openssl rand -hex 32`, never reuse a value ---
JWT_SECRET=
SECRET_KEY=
GITHUB_WEBHOOK_SECRET=

# --- PostgreSQL ---
POSTGRES_USER=patchforge
POSTGRES_PASSWORD=
POSTGRES_DB=patchforge_db

# --- Local LLM (Ollama, running as its own container in this stack) ---
OLLAMA_MODEL=qwen2.5-coder:1.5b

# --- GitHub Integration (optional - only needed for live PR creation) ---
GITHUB_ACCESS_TOKEN=
