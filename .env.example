# ==============================================================================
# PatchForge AI - Environment Configuration Template
# ==============================================================================

# --- Application Core ---
PROJECT_NAME="PatchForge AI"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"
SECRET_KEY="generate_a_secure_random_secret_key_here_for_production"
JWT_SECRET="generate_a_secure_jwt_secret_key_here_for_production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_HOSTS="localhost,127.0.0.1"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
# Comma-separated emails that get ADMIN on first registration/login instead of
# DEVELOPER. This is the only way to reach an elevated role - set this to your
# own email, or you'll never be able to create PRs or delete repositories.
ADMIN_EMAILS=

# --- PostgreSQL Relational Database ---
POSTGRES_USER=patchforge
POSTGRES_PASSWORD=patchforge_secure_pass
POSTGRES_DB=patchforge_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://patchforge:patchforge_secure_pass@localhost:5432/patchforge_db
# When running inside Docker containers, use postgres service name:
# DATABASE_URL=postgresql://patchforge:patchforge_secure_pass@postgres:5432/patchforge_db

# --- Redis Message Broker & State Cache ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
# When running inside Docker containers:
# REDIS_URL=redis://redis:6379/0

# --- Groq Cloud LLM Engine (default patch-generation backend) ---
# Free tier, no credit card required: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=60

# --- Local LLM Engine (Ollama) - only needed if you're self-hosting a model
# instead of using Groq above ---
OLLAMA_BASE_URL=http://localhost:11434
# Inside Docker containers:
# OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_TIMEOUT_SECONDS=120

# --- Sandbox Execution Security ---
DOCKER_SOCKET=/var/run/docker.sock
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_QUOTA=1.0
SANDBOX_NETWORK_DISABLED=true

# --- GitHub Integration & Webhooks ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET="patchforge_webhook_secret_hmac_256"
GITHUB_ACCESS_TOKEN=
